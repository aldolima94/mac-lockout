<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.randy.maclockout</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/usr/local/maclockout/maclockoutd.sh</string>
    </array>

    <!-- start at boot, and restart if it ever exits -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardErrorPath</key>
    <string>/usr/local/maclockout/daemon.err</string>
    <key>StandardOutPath</key>
    <string>/usr/local/maclockout/daemon.out</string>
</dict>
</plist>
